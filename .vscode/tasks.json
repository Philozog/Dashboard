{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Dashboard",
            "type": "shell",
            "command": "python main.py",
        
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUNBUFFERED": "1"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "detail": "Start the local Dash dashboard with the selected Python interpreter."
        }
    ]
}
